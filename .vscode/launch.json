{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pipeline: synthetic data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "args": ["--synthetic-only"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Pipeline: HUPA raw data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_pipeline.py",
      "args": ["--input", "data/raw", "--no-sample-fallback"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Download HUPA dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/download_hupa.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Train model (GPU, patience=7)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_model.py",
      "args": [
        "--raw-input", "data/raw",
        "--epochs", "100",
        "--patience", "7"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "Train model: synthetic (GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_model.py",
      "args": ["--synthetic-only", "--epochs", "100", "--patience", "7"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "Evaluate model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate_model.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "End-to-end demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_end_to_end.py",
      "args": ["--epochs", "20", "--patience", "7"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0"
      }
    },
    {
      "name": "LLM parser: Gemma 12B",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_llm_parser.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "CUDA_VISIBLE_DEVICES": "0",
        "HF_TOKEN": "${env:HF_TOKEN}"
      }
    },
    {
      "name": "LLM parser: rule-based",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_llm_parser.py",
      "args": ["--rule-based"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Guardrails CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_guardrails.py",
      "args": ["--current-bg", "90", "--previous-bg", "110", "--iob", "0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Validate data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
